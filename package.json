{
  "name": "win-down",
  "version": "0.1.0",
  "description": "Windows multi-threaded downloader with Node-API bindings (Rust + WinHTTP)",
  "main": "cjs/index.cjs",
  "types": "cjs/index.d.cts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuxiaojt/win-down.git"
  },
  "files": [
    "cjs/index.cjs",
    "cjs/index.d.cts",
    "esm/index.mjs",
    "esm/index.d.mts",
    "native/win_down.node",
    "LICENSE",
    "README.md",
    "README-CN.md"
  ],
  "exports": {
    ".": {
      "import": "./esm/index.mjs",
      "require": "./cjs/index.cjs",
      "types": "./cjs/index.d.cts"
    }
  },
  "scripts": {
    "build:ts:cjs": "tsc -p tsconfig.cjs.json",
    "build:ts:esm": "tsc -p tsconfig.esm.json",
    "build:ts": "npm run build:ts:cjs && npm run build:ts:esm",
    "build:native": "node scripts/build.js",
    "build": "npm run build:ts && npm run build:native",
    "test": "node test/test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": ["win32"],
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
